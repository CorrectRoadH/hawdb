{
  "compilerOptions": {
    "target": "ESNext", "module": "NodeNext", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "erasableSyntaxOnly": true, "allowImportingTsExtensions": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noEmit": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["*.ts", "tests/**/*.ts"]
}
